rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario (el taller) solo puede leer y escribir dentro de SU carpeta:
    // usuarios/{uid}/clientes, arreglos, pagos, recordatorios y ajustes
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado
  }
}
